{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.platform.local/events/platform.job.requested.v1.json",
  "title": "异步作业请求事件 v1",
  "x-event-name": "platform.job.requested.v1",
  "x-event-version": 1,
  "allOf": [
    {
      "$ref": "./envelope.v1.json"
    },
    {
      "type": "object",
      "required": ["data"],
      "properties": {
        "data": {
          "type": "object",
          "required": ["job_id", "job_type", "requested_by"],
          "properties": {
            "job_id": { "type": "string", "format": "uuid" },
            "job_type": { "type": "string" },
            "requested_by": { "type": "string" },
            "trace_id": { "type": "string" },
            "correlation_id": { "type": "string" }
          }
        }
      }
    }
  ]
}
