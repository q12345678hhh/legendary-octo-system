{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.platform.local/events/platform.file.uploaded.v1.json",
  "title": "文件上传完成事件 v1",
  "x-event-name": "platform.file.uploaded.v1",
  "x-event-version": 1,
  "allOf": [
    {
      "$ref": "./envelope.v1.json"
    },
    {
      "type": "object",
      "required": ["data"],
      "properties": {
        "data": {
          "type": "object",
          "required": ["file_id", "object_key", "content_type", "size_bytes", "subject_id"],
          "properties": {
            "file_id": { "type": "string", "format": "uuid" },
            "object_key": { "type": "string" },
            "content_type": { "type": "string" },
            "size_bytes": { "type": "integer", "minimum": 1 },
            "subject_id": { "type": "string" }
          }
        }
      }
    }
  ]
}
