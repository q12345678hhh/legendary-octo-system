{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.platform.local/plugins/plugin-manifest.v1.json",
  "title": "插件 manifest v1",
  "description": "插件只能声明权限与资源限额，不得扩展字段。执行器按 limits 与 permissions 强制约束。",
  "type": "object",
  "required": ["name", "version", "protocol_version", "entrypoint", "permissions", "limits"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "protocol_version": {
      "type": "integer",
      "const": 1
    },
    "entrypoint": {
      "type": "string"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["tenant.read", "tenant.write", "worklog.read"]
      }
    },
    "limits": {
      "type": "object",
      "required": ["memory_mb", "cpu_seconds", "network"],
      "properties": {
        "memory_mb": {
          "type": "integer",
          "minimum": 32,
          "maximum": 1024
        },
        "cpu_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "network": {
          "type": "string",
          "enum": ["none"]
        }
      }
    }
  }
}
