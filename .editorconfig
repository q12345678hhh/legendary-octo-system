root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 120

[*.{java,xml}]
indent_size = 4

[*.{cs,csproj,props,sln}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json,jsonc,mjs,cjs,js,ts,tsx,css,html}]
indent_size = 2

[Makefile]
indent_style = tab
