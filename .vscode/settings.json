{
  // Java 21 是 WP00-02 锁定的运行时；本机默认 JAVA_HOME 可能仍是 1.8，
  // 因此这里显式钉住 JDK，调试与任务都走同一个。
  "java.jdt.ls.java.home": "C:\\Program Files\\Eclipse Adoptium\\jdk-21.0.12.101-hotspot",
  "java.configuration.runtimes": [
    {
      "name": "JavaSE-21",
      "path": "C:\\Program Files\\Eclipse Adoptium\\jdk-21.0.12.101-hotspot",
      "default": true
    }
  ],
  "java.configuration.updateBuildConfiguration": "automatic",
  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "java.compile.nullAnalysis.mode": "automatic",
  // JDT 语言服务器会用 ECJ 自动构建并覆盖 target/，其类路径缺失跨模块测试依赖时会写出
  // “Unresolved compilation problems” 桩类，导致 surefire 报 ClassNotFoundException。
  // 本仓库以 Maven 为准，关闭自动构建。
  "java.autobuild.enabled": false
}
