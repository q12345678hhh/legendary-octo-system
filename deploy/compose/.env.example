# 本地开发环境变量模板（WP01-02）。
# 用法：cp .env.example .env（.env 已被 .gitignore 忽略，不会进版本库）。
# 这些口令只对本地拓扑有效，任何共享环境必须另行生成，不得复用本文件。

# PostgreSQL：owner 负责迁移建表，app 是运行期账号（NOBYPASSRLS）
POSTGRES_PORT=5432
POSTGRES_OWNER_PASSWORD=dev_only_change_me
POSTGRES_APP_PASSWORD=dev_only_change_me_app

# Redis
REDIS_PORT=6379

# 对象存储：API 与 Console 分开映射，桶名按租户前缀规划
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=platform_dev
MINIO_ROOT_PASSWORD=dev_only_change_me_minio
MINIO_BUCKET=platform-dev

# 邮件捕获：SMTP 给应用，8025 是浏览器查看界面
SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# OTLP 收集端
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
