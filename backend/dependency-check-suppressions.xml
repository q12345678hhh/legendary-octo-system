<?xml version="1.0" encoding="UTF-8"?>
<!--
  OWASP dependency-check 误报抑制清单。

  规则只有一条：Java 侧 Prometheus / Micrometer 指标库被按 CPE 匹配到了
  Prometheus 服务端（Go 编译的时序数据库与 HTTP 服务）。两者同名不同物，
  NVD 的 CVE 描述针对的是服务端二进制，对 JVM 客户端库不成立。

  抑制条件写得尽量窄：同时限定 packageUrl（Maven 坐标 + 版本模式）和 cpe，
  不用 CVEv5 前缀一把梭，避免掩盖真正影响这些 jar 的漏洞。
  每次新增条目必须写清误报依据与复核日期。
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

  <!--
    误报依据：CVE-2026-42154 描述的是 Prometheus 服务端 /api/v1/read 的
    snappy 解压内存放大（3.5.3、3.11.3 修复），属于 Go 服务端进程。
    micrometer-registry-prometheus 只是把 JVM 指标编码成文本/OpenMetrics，
    不实现 /api/v1/read，也不监听 Prometheus 端口。
    复核日期：2026-11-11（随 WP01-04 引入该依赖时确认）。
  -->
  <suppress>
    <notes><![CDATA[
      micrometer-registry-prometheus 被 CPE 匹配到 Prometheus 服务端。
      CVE-2026-42154 影响服务端 /api/v1/read，与 JVM 指标导出无关。
      复核：2026-11-11，WP01-04。
    ]]></notes>
    <packageUrl regex="true">^pkg:maven/io\.micrometer/micrometer-registry-prometheus@.*$</packageUrl>
    <cpe>cpe:/a:prometheus:prometheus</cpe>
  </suppress>

  <!--
    同一误报来源：Micrometer 依赖的 Prometheus Java 客户端（io.prometheus:*）。
    这些 jar 只做序列化，不包含服务端读取接口。
  -->
  <suppress>
    <notes><![CDATA[
      Prometheus Java 客户端（io.prometheus:*）被 CPE 匹配到服务端。
      同上，CVE-2026-42154 不影响客户端序列化实现。
      复核：2026-11-11，WP01-04。
    ]]></notes>
    <packageUrl regex="true">^pkg:maven/io\.prometheus/prometheus-metrics-.*@.*$</packageUrl>
    <cpe>cpe:/a:prometheus:prometheus</cpe>
  </suppress>

</suppressions>
