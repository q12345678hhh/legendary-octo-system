<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.acme.platform</groupId>
    <artifactId>platform-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>boot-api</artifactId>
  <name>Bootstrap: API</name>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-core</artifactId>
    </dependency>

    <dependency>
      <groupId>com.acme.platform</groupId>
      <artifactId>tenancy</artifactId>
    </dependency>
    <dependency>
      <groupId>com.acme.platform</groupId>
      <artifactId>identity</artifactId>
    </dependency>
    <dependency>
      <groupId>com.acme.platform</groupId>
      <artifactId>organization</artifactId>
    </dependency>
    <dependency>
      <groupId>com.acme.platform</groupId>
      <artifactId>authorization</artifactId>
    </dependency>
    <dependency>
      <groupId>com.acme.platform</groupId>
      <artifactId>department</artifactId>
    </dependency>
    <dependency>
      <groupId>com.acme.platform</groupId>
      <artifactId>appcatalog</artifactId>
    </dependency>
    <dependency>
      <groupId>com.acme.platform</groupId>
      <artifactId>lowcode</artifactId>
    </dependency>
    <dependency>
      <groupId>com.acme.platform</groupId>
      <artifactId>workflow</artifactId>
    </dependency>
    <dependency>
      <groupId>com.acme.platform</groupId>
      <artifactId>hr</artifactId>
    </dependency>
    <dependency>
      <groupId>com.acme.platform</groupId>
      <artifactId>worklog</artifactId>
    </dependency>
    <dependency>
      <groupId>com.acme.platform</groupId>
      <artifactId>collaboration</artifactId>
    </dependency>
    <dependency>
      <groupId>com.acme.platform</groupId>
      <artifactId>integration</artifactId>
    </dependency>
    <dependency>
      <groupId>com.acme.platform</groupId>
      <artifactId>plugin</artifactId>
    </dependency>
    <dependency>
      <groupId>com.acme.platform</groupId>
      <artifactId>ai</artifactId>
    </dependency>
    <dependency>
      <groupId>com.acme.platform</groupId>
      <artifactId>platform</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>repackage</id>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
