<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.acme.platform</groupId>
    <artifactId>platform-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>boot-worker</artifactId>
  <name>Bootstrap: Worker</name>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- Worker 非 Web 应用，需显式引入 Jackson 自动配置以发布/消费事件载荷 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-core</artifactId>
    </dependency>

    <!-- 消费 outbox 需要直连数据库：运行期用 platform_app，迁移由 API 进程负责 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>com.acme.platform</groupId>
      <artifactId>platform</artifactId>
    </dependency>
    <dependency>
      <groupId>com.acme.platform</groupId>
      <artifactId>tenancy</artifactId>
    </dependency>
    <!-- 组织变更到期应用：Worker 是唯一跨租户扫描平台级到期队列的进程 -->
    <dependency>
      <groupId>com.acme.platform</groupId>
      <artifactId>organization</artifactId>
    </dependency>
    <!-- 季度访问复核：Worker 跨租户认领到期队列并逐租户生成/升级/暂停 -->
    <dependency>
      <groupId>com.acme.platform</groupId>
      <artifactId>authorization</artifactId>
    </dependency>
    <dependency>
      <groupId>com.acme.platform</groupId>
      <artifactId>worklog</artifactId>
    </dependency>
    <dependency>
      <groupId>com.acme.platform</groupId>
      <artifactId>workflow</artifactId>
    </dependency>
    <dependency>
      <groupId>com.acme.platform</groupId>
      <artifactId>integration</artifactId>
    </dependency>
    <dependency>
      <groupId>com.acme.platform</groupId>
      <artifactId>ai</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>repackage</id>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
